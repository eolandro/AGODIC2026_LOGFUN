pareja("Bill Weasley","Fleur Isabelle Delacour").
pareja("Percy Weasley","Audrey").
pareja("George Weasley","Angelina").
pareja("Ronald Weasley","Hermione Jean Granger").
pareja("Harry James Potter","Ginevra Molly Weasley").
pareja("Ted Tonks","Andromeda Black").
pareja("Remus Lupin","Nymphadora Tonks").
pareja("Lucius Malfoy","Narcissa Black").
pareja("Draco Lucius Malfoy","Astoria Greengrass").
pareja("Rodolphus Lestrange","Bellatrix Black").
pareja("Rolf Scamander","Luna Lovegood").
pareja("Frank Longbottom","Alice").

hermano_a(Ego,Persona) :-
    Ego \== Persona,
    progenitor_a(Padre,Ego),
    progenitor_a(Padre,Persona).
yerno(Ego,Persona) :-
    pareja(Ego,Mujer),
    progenitor_a(Persona,Mujer).
bisnieto_a(Ego,Persona) :-
    progenitor_a(Persona,Hijo),
    progenitor_a(Hijo,Nieto),
    progenitor_a(Nieto,Ego).
abuelo_a(Ego,Persona) :-
    progenitor_a(Ego,Padre),
    progenitor_a(Padre,Persona).
sobrino_a_nieto(Ego,Persona) :-
    progenitor_a(Padre,Ego),
    progenitor_a(Abuelo,Padre),
    hermano_a(Abuelo,Persona).
tio_bisabuelo_a(Ego,Persona) :-
    progenitor_a(Padre,Ego),
    progenitor_a(Abuelo,Padre),
    progenitor_a(Bisabuelo,Abuelo),
    hermano_a(Bisabuelo,Persona).

% ----------------------------------------------

% R002

descendiente(Ego,Persona2) :-
    progenitor_a(Persona2,Ego).
descendiente(Ego,Persona2) :-
    progenitor_a(Padre,Ego),
    descendiente(Padre,Persona2).

% ----------------------------------------------

% R003

descendientes(Ego,ListaDESCENDIENTES) :-
    findall(Desc,descendiente(Desc,Ego),ListaDESCENDIENTES).

% ----------------------------------------------

% R004

seq0(0,7).

seq0(N,R) :-
    N > 0,
    N1 is N-1,
    seq0(N1,R1),
    R is 2*R1+3.

