% R005

grafo("A","B").
grafo("B","C").
grafo("C","D").
grafo("D","E").
grafo("E","F").
grafo("F","G").
grafo("G","H").
grafo("H","I").
grafo("I","J").
grafo("J","A").

imp_graf_cir(Inicio,Inicio) :-
    writeln(Inicio).
imp_graf_cir(Inicio,Limite) :-
    Inicio \== Limite,
    writeln(Inicio),
    grafo(Inicio,Siguiente),
    imp_graf_cir(Siguiente,Limite).

% ----------------------------------------------

% R006

badaboom(N,"Bada Boom!!") :-
    A is N mod 3,
    B is N mod 5,
    A == 0,
    B == 0.
badaboom(N,"Bada") :-
    A is N mod 3,
    A == 0.
badaboom(N,"Boom!!") :-
    B is N mod 5,
    B == 0.
badaboom(N,N) :-
    A is N mod 3,
    B is N mod 5,
    A \== 0,
    B \== 0.

% ----------------------------------------------

% R007

lista_badaboom(N,L) :-
    lista_badaboom_aux(1,N,L).
lista_badaboom_aux(Inicio,N,[]) :-
    Inicio > N.
lista_badaboom_aux(N,N,[R]) :-
    badaboom(N,R).
lista_badaboom_aux(Inicio,N,L) :-
    Inicio < N,
    badaboom(Inicio,R),
    Siguiente is Inicio+1,
    lista_badaboom_aux(Siguiente,N,LR),
    append([R],LR,L).

% ----------------------------------------------

% R008

pirata([],PX,PY,RX,RY) :-
    RX = PX,
    RY = PY.
pirata(["A"|C],PX,PY,RX,RY) :-
    PY1 is PY+1,
    pirata(C,PX,PY1,RX,RY).
pirata(["V"|C],PX,PY,RX,RY) :-
    PY1 is PY-1,
    pirata(C,PX,PY1,RX,RY).
pirata([">"|C],PX,PY,RX,RY) :-
    PX1 is PX+1,
    pirata(C,PX1,PY,RX,RY).
pirata(["<"|C],PX,PY,RX,RY) :-
    PX1 is PX-1,
    pirata(C,PX1,PY,RX,RY).

% ----------------------------------------------

% R009

combina_listas([],L2,L2).

combina_listas(L1,[],L1).

combina_listas([F|C],[G|D],R) :-
    append([F,G],R1,R),
    combina_listas(C,D,R1).
